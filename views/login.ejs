<%- include('partials/head', { title: '로그인' }) %>

<main style="display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 24px;">
  <div style="width: 100%; max-width: 380px;" class="fade-in">
    <div style="text-align: center; margin-bottom: 32px;">
      <h1 style="font-size: 1.5rem; margin-bottom: 6px;">IG Dashboard</h1>
      <p class="text-secondary text-sm">Instagram Content Automation</p>
    </div>

    <div class="card" style="padding: 32px;">
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <form method="POST" action="/login">
        <label>
          아이디
          <input type="text" name="username" required autofocus placeholder="admin">
        </label>
        <label>
          비밀번호
          <input type="password" name="password" required placeholder="••••••••">
        </label>
        <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center; margin-top: 8px;">로그인</button>
      </form>
    </div>
  </div>
</main>

<%- include('partials/foot') %>
