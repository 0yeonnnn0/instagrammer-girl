<!DOCTYPE html>
<html lang="ko" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' — ' : '' %>IG Dashboard</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
  <script src="https://unpkg.com/htmx.org@2.0.4"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <style>
    :root { --pico-font-size: 15px; }
    .badge { display: inline-block; padding: 2px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: 600; }
    .badge-success { background: #22c55e22; color: #22c55e; }
    .badge-danger { background: #ef444422; color: #ef4444; }
    .badge-warning { background: #eab30822; color: #eab308; }
    .badge-info { background: #3b82f622; color: #3b82f6; }
    .badge-muted { background: #64748b22; color: #64748b; }
    .grid-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1rem; }
    .status-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; margin-right: 6px; }
    .status-dot.active { background: #22c55e; }
    .status-dot.paused { background: #64748b; }
    .thumb-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 0.5rem; }
    .thumb-grid img { width: 100%; border-radius: 6px; }
    nav { margin-bottom: 1.5rem; }
    .text-muted { color: var(--pico-muted-color); }
    .text-sm { font-size: 0.85rem; }
    .mt-1 { margin-top: 1rem; }
    .mb-1 { margin-bottom: 1rem; }
    .flex { display: flex; align-items: center; gap: 0.5rem; }
    .flex-between { display: flex; justify-content: space-between; align-items: center; }
  </style>
</head>
<body>
  <% if (typeof authenticated !== 'undefined' && authenticated) { %>
  <nav class="container">
    <ul>
      <li><strong><a href="/">📸 IG Dashboard</a></strong></li>
    </ul>
    <ul>
      <li><a href="/">홈</a></li>
      <li><a href="/accounts">계정</a></li>
      <li>
        <form method="POST" action="/logout" style="margin:0">
          <button type="submit" class="outline secondary" style="padding:4px 12px;margin:0">로그아웃</button>
        </form>
      </li>
    </ul>
  </nav>
  <% } %>

  <main class="container">
    <% if (typeof flash !== 'undefined' && flash) { %>
      <article style="padding: 0.75rem 1rem; margin-bottom: 1rem;">
        <%= flash %>
      </article>
    <% } %>

    <%- body %>
  </main>

  <footer class="container">
    <small class="text-muted">IG Dashboard — Instagram Content Automation</small>
  </footer>
</body>
</html>
