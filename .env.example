# Cloudinary (이미지 호스팅)
# https://console.cloudinary.com/ 에서 확인
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Buffer API (Instagram 업로드)
# https://buffer.com/developers → API Token 발급
# 토큰 넣은 후 `node scripts/upload.js --list-channels` 로 채널 ID 확인
BUFFER_API_TOKEN=your_buffer_api_token
BUFFER_ORG_ID=your_org_id
BUFFER_CHANNEL_ID=your_instagram_channel_id
