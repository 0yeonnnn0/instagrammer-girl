# ── Instagram Graph API (직접 업로드) ──
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id

# ── Cloudinary (이미지/영상 중계 호스팅) ──
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Dashboard 설정 (웹 대시보드 사용 시) ──
ENCRYPTION_KEY=change-this-to-a-random-32char-string
SESSION_SECRET=change-this-to-a-random-32char-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ── AI Provider 기본값 (선택) ──
# claude | codex
AI_PROVIDER=claude
# 예: sonnet / gpt-5.4
AI_MODEL=
