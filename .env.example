# ── Dashboard Required Settings ────────────────────────
# Used to encrypt stored account secrets in SQLite.
# Set once and keep it stable after first production use.
ENCRYPTION_KEY=replace-with-a-random-32-plus-char-string

# Used to sign dashboard login sessions.
SESSION_SECRET=replace-with-a-different-random-32-plus-char-string

# Initial dashboard admin account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# ── AI Provider Defaults (Optional) ────────────────────
# Account-level settings in the dashboard override these defaults.
# claude | codex
AI_PROVIDER=codex
# Example: sonnet / gpt-5.4
AI_MODEL=gpt-5.4

# Run scheduler inside server.js process (not recommended when worker.js is running)
# 0 or empty: disabled (recommended)
# 1: enabled
SERVER_RUN_SCHEDULER=0

# ── Instagram Graph API (Direct Upload) ────────────────
# Shared defaults for scripts and dashboard migrations.
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id

# ── Cloudinary (Image/Video Hosting) ───────────────────
# Shared defaults for scripts and dashboard migrations.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Legacy Buffer Upload Script (Optional) ─────────────
# Only needed if you still use scripts/upload.js.
BUFFER_API_TOKEN=
BUFFER_ORG_ID=
BUFFER_CHANNEL_ID=
